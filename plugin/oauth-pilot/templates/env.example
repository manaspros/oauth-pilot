# OAuth Pilot: copy these lines into your own .env (which must be gitignored).
# Paste client ID and secret yourself. Never share them in chat.
COMPOSIO_API_KEY=
# Replace <APP> with e.g. LINEAR, GMAIL, SALESFORCE
<APP>_CLIENT_ID=
<APP>_CLIENT_SECRET=
<APP>_SCOPES=
# Written by scripts/composio-auth-config.mjs
COMPOSIO_AUTH_CONFIG_<APP>=
