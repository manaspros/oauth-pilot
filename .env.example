# LLM: any Anthropic-compatible endpoint. We use a LiteLLM proxy that passes through /v1/messages.
ANTHROPIC_BASE_URL=          # e.g. https://<your-litellm-proxy>  (leave empty for api.anthropic.com)
ANTHROPIC_API_KEY=           # LiteLLM virtual key, or a real Anthropic key
COMPOSIO_API_KEY=
OAUTH_PILOT_MODEL=claude-sonnet-5-5
OAUTH_PILOT_URL=http://localhost:3000
OAUTH_PILOT_FAKE=0
DATA_DIR=./data
GUIDES_DIR=./guides
