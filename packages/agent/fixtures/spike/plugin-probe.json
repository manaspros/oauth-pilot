{
  "claude_version": "2.1.311",
  "plugin_layout": {
    ".claude-plugin/plugin.json": "{\"name\":\"oauth-pilot\",\"version\":\"0.1.0\",\"description\":\"spike\",\"author\":{\"name\":\"spike\"}}",
    ".mcp.json": "{\"mcpServers\":{\"oauth-pilot\":{\"command\":\"node\",\"args\":[\"${CLAUDE_PLUGIN_ROOT}/bin/mcp.mjs\"]}}}",
    "skills/oauth-setup/SKILL.md": "frontmatter name+description; body may use ${CLAUDE_PLUGIN_ROOT}"
  },
  "validate": {
    "cmd": "claude plugin validate <dir>",
    "good_plugin": "exit 0, 'Validation passed' (+ directory-profile notes: README/LICENSE/icon missing, non-fatal unless --profile directory)",
