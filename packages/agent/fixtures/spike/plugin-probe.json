  },
  "run": {
    "cmd": "claude -p --plugin-dir <dir> --output-format stream-json --verbose --max-turns 3 \"<prompt>\"",
    "init_event": {
      "plugins[0]": {"name": "oauth-pilot", "source": "oauth-pilot@inline", "version": "0.1.0"},
      "mcp_servers[0]": {"name": "plugin:oauth-pilot:oauth-pilot", "status": "connected", "source": "plugin"},
      "skills": ["oauth-pilot:oauth-setup"],
      "slash_commands": ["oauth-pilot:oauth-setup"],
      "mcp_tool_name": "mcp__plugin_oauth-pilot_oauth-pilot__ping"
    },
    "tool_result": "pong",
    "result": "success"
  }
}
